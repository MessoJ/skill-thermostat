# -----------------------------------------------------------------------------
# Google Gemini API Settings (Primary AI Tutor)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# -----------------------------------------------------------------------------
# Optional Alternative Providers
# -----------------------------------------------------------------------------
# Anthropic Claude API (used if ANTHROPIC_API_KEY is set and GEMINI_API_KEY is not)
ANTHROPIC_API_KEY=
HELPER_MODEL=

# -----------------------------------------------------------------------------
# Study Infrastructure & Security
# -----------------------------------------------------------------------------
# Shared secret for authenticating requests between study_app and runner_service
RUNNER_KEY=local-dev-runner-secret

# Remote runner service URL (set in Docker or when runner runs separately)
# RUNNER_URL=http://runner:9000

# Bearer token for accessing /api/admin/summary from non-localhost IPs
ADMIN_TOKEN=dev-admin-secret-change-me

# Server port (default: 8001)
PORT=8001
