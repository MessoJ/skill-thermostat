# Sandbox image: runs learner code. Contains ONLY the runner, no database, no secrets, no numpy, no app code.
FROM python:3.12-slim
WORKDIR /srv
RUN mkdir pilot && touch pilot/__init__.py && useradd -r -u 10002 runner
COPY pilot/runner.py pilot/runner_service.py ./pilot/
USER runner
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/srv
EXPOSE 9000
CMD ["python", "-m", "pilot.runner_service", "--host", "0.0.0.0", "--port", "9000"]
