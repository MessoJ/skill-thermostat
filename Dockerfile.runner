FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pilot/__init__.py ./pilot/__init__.py
COPY pilot/runner.py ./pilot/runner.py
COPY pilot/runner_service.py ./pilot/runner_service.py

RUN chown -R 65534:65534 /app && chmod -R a-w /app

USER 65534:65534

EXPOSE 9000

HEALTHCHECK --interval=10s --timeout=2s --start-period=2s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9000/health')" || exit 1

CMD ["python", "-m", "pilot.runner_service", "--host", "0.0.0.0", "--port", "9000"]
